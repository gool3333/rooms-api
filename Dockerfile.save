FROM python:3.12-slim AS test
WORKDIR /app
COPY app.py test_app.py ./
RUN python -m unittest -v

FROM python:3.12-slim
WORKDIR /app
RUN useradd --create-home appuser
COPY --from=test /app/app.py .
ARG APP_VERSION=dev
ENV APP_VERSION=$APP_VERSION
USER appuser
EXPOSE 8000
HEALTHCHECK --interval=10s --timeout=3s CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')"
CMD ["python", "app.py"]
printf '.git\n.git\ndeploy\ntools\n__pycache__\n*.md\n' > .dockerignore && cat .dockerignore
docker build --build-arg APP_VERSION=local-1 -t rooms-api:local .
docker run -d --name rooms-local -p 8000:8000 rooms-api:local
curl http://localhost:8000/health
curl http://localhost:8000/rooms
curl -X POST http://localhost:8000/bookings -H "Content-Type: application/json" -d '{"room":"vega","hour":10,"who":"Ivanov"}'
curl -i -X POST http://localhost:8000/bookings -H "Content-Type: application/json" -d '{"room":"vega","hour":10,"who":"Petrov"}'
docker rm -f rooms-local
